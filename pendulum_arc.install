<?php

/**
 * @file
 * Install, update, and uninstall functions for Pendulum Arc.
 */

declare(strict_types=1);

use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function pendulum_arc_install(): void {
  $role = Role::load('administrator');
  if ($role && !$role->isAdmin() && !$role->hasPermission('administer pendulum arc')) {
    $role->grantPermission('administer pendulum arc');
    $role->save();
  }
}

/**
 * Implements hook_uninstall().
 */
function pendulum_arc_uninstall(): void {
  \Drupal::state()->delete('pendulum_arc.connection');
  \Drupal::state()->delete('pendulum_arc.consent');
  \Drupal::keyValueExpirable('pendulum_arc')->deleteAll();
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('pendulum_arc_consent_log')) {
    $schema->dropTable('pendulum_arc_consent_log');
  }
  if ($schema->tableExists('pendulum_arc_keyphrases')) {
    $schema->dropTable('pendulum_arc_keyphrases');
  }
  \Drupal::state()->delete('pendulum_arc.keyphrases');
  \Drupal::state()->delete('pendulum_arc.google_missing');
}

/**
 * Consent log. Settings live in state, not in this schema.
 */
function pendulum_arc_schema(): array {
  return [
    'pendulum_arc_consent_log' => [
      'description' => 'Local cookie consent choices.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'created_gmt' => [
          'type' => 'varchar',
          'length' => 20,
          'not null' => TRUE,
          'default' => '',
        ],
        'consent_version' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'action' => [
          'type' => 'varchar',
          'length' => 16,
          'not null' => TRUE,
          'default' => '',
        ],
        'allowed' => [
          'type' => 'text',
          'not null' => TRUE,
          'size' => 'big',
        ],
        'refused' => [
          'type' => 'text',
          'not null' => TRUE,
          'size' => 'big',
        ],
        'ip' => [
          'type' => 'varchar',
          'length' => 45,
          'not null' => TRUE,
          'default' => '',
        ],
        'user_agent' => [
          'type' => 'varchar',
          'length' => 500,
          'not null' => TRUE,
          'default' => '',
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'created_gmt' => ['created_gmt'],
      ],
    ],
    'pendulum_arc_keyphrases' => [
      'description' => 'Local focus keyphrases waiting to sync with Arc.',
      'fields' => [
        'path_hash' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
          'default' => '',
        ],
        'path' => [
          'type' => 'varchar',
          'length' => 512,
          'not null' => TRUE,
          'default' => '',
        ],
        'phrase' => [
          'type' => 'varchar',
          'length' => 500,
          'not null' => TRUE,
          'default' => '',
        ],
        'synced_phrase' => [
          'type' => 'varchar',
          'length' => 500,
          'not null' => TRUE,
          'default' => '',
        ],
        'deleted' => [
          'type' => 'int',
          'size' => 'tiny',
          'not null' => TRUE,
          'default' => 0,
        ],
        'entity_type' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => '',
        ],
        'entity_id' => [
          'type' => 'varchar',
          'length' => 128,
          'not null' => TRUE,
          'default' => '',
        ],
        'langcode' => [
          'type' => 'varchar',
          'length' => 12,
          'not null' => TRUE,
          'default' => '',
        ],
      ],
      'primary key' => ['path_hash'],
      'indexes' => [
        'entity' => ['entity_type', 'entity_id', 'langcode'],
      ],
    ],
  ];
}

/**
 * Creates the consent log table on installs that predate the banner.
 */
function pendulum_arc_update_8001(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('pendulum_arc_consent_log')) {
    $schema->createTable('pendulum_arc_consent_log', pendulum_arc_schema()['pendulum_arc_consent_log']);
  }
}

/**
 * Creates the local keyphrase list.
 */
function pendulum_arc_update_8002(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('pendulum_arc_keyphrases')) {
    $schema->createTable('pendulum_arc_keyphrases', pendulum_arc_schema()['pendulum_arc_keyphrases']);
  }
}
