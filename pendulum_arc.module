<?php

/**
 * @file
 * Connects this Drupal site to a Pendulum Arc account.
 */

declare(strict_types=1);

use Drupal\Core\Asset\AttachedAssetsInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_theme().
 */
function pendulum_arc_theme($existing, $type, $theme, $path): array {
  return [
    'pendulum_arc_page' => [
      'variables' => [
        'title' => '',
        'mark' => '',
        'bootstrap' => '{}',
        'message' => '',
      ],
    ],
    'pendulum_arc_widget' => [
      'variables' => [
        'dashboard_url' => '',
        'connect_url' => '',
        'portal_url' => '',
        'connected' => '0',
      ],
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function pendulum_arc_page_attachments(array &$attachments): void {
  if (!\Drupal::currentUser()->hasPermission('administer pendulum arc')) {
    return;
  }
  $attachments['#attached']['library'][] = 'pendulum_arc/menu';
  $attachments['#attached']['drupalSettings']['pendulumArc']['menuCount'] = \Drupal::service('pendulum_arc.alerts')->menuCount();
}

/**
 * Implements hook_cron().
 */
function pendulum_arc_cron(): void {
  \Drupal::service('pendulum_arc.keyphrases')->cron();
}

/**
 * Implements hook_entity_insert().
 */
function pendulum_arc_entity_insert(EntityInterface $entity): void {
  \Drupal::service('pendulum_arc.keyphrases')->refreshEntity($entity);
}

/**
 * Implements hook_entity_update().
 */
function pendulum_arc_entity_update(EntityInterface $entity): void {
  \Drupal::service('pendulum_arc.keyphrases')->refreshEntity($entity);
}

/**
 * Implements hook_entity_predelete().
 */
function pendulum_arc_entity_predelete(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'path_alias') {
    return;
  }
  \Drupal::service('pendulum_arc.keyphrases')->forgetEntity($entity);
}

/**
 * Implements hook_entity_delete().
 *
 * A removed alias is already gone, so the entity URL is read again.
 */
function pendulum_arc_entity_delete(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'path_alias') {
    return;
  }
  \Drupal::service('pendulum_arc.keyphrases')->refreshEntity($entity);
}

/**
 * Implements hook_page_top().
 */
function pendulum_arc_page_top(array &$page_top): void {
  \Drupal::service('pendulum_arc.consent_front')->pageTop($page_top);
}

/**
 * Implements hook_page_bottom().
 */
function pendulum_arc_page_bottom(array &$page_bottom): void {
  \Drupal::service('pendulum_arc.consent_front')->pageBottom($page_bottom);
}

/**
 * Implements hook_preprocess_page().
 */
function pendulum_arc_preprocess_page(array &$variables): void {
  \Drupal::service('pendulum_arc.consent_front')->placeInRegion($variables);
}

/**
 * Implements hook_js_alter().
 */
function pendulum_arc_js_alter(array &$javascript, AttachedAssetsInterface $assets, LanguageInterface $language): void {
  \Drupal::service('pendulum_arc.consent_front')->alterJavascript($javascript, $assets);
}

/**
 * Implements hook_requirements().
 */
function pendulum_arc_requirements(string $phase): array {
  if (function_exists('sodium_crypto_secretbox')) {
    return [];
  }
  return [
    'pendulum_arc_sodium' => [
      'title' => t('Arc Analytics'),
      'value' => t('PHP sodium extension is missing'),
      'description' => t('Arc Analytics needs the PHP sodium extension before it can store a connection.'),
      'severity' => REQUIREMENT_ERROR,
    ],
  ];
}

/**
 * Implements hook_help().
 */
function pendulum_arc_help(string $route_name, RouteMatchInterface $route_match): string {
  if ($route_name !== 'help.page.pendulum_arc') {
    return '';
  }
  return '<p>' . t('Arc Analytics connects this site to an Arc studio so the dashboard can show the latest site scores and a preview of each report. GDPR Consent is a local cookie banner. It does not call Arc and works before the site is paired.') . '</p>';
}
